{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && esbuild serverless/vercel-handler.ts --bundle --platform=node --format=cjs --packages=bundle --external:vite --outfile=api/index.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.cjs": {
      "maxDuration": 60
    }
  }
}
